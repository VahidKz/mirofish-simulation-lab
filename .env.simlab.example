# ChatGPT session is reused by the official SDK. No API key is needed.
MODEL_PROVIDER=codex
CODEX_MODEL=
SIMLAB_MAX_CALLS=24
SIMLAB_MODEL_RETRIES=1
SIMLAB_CALL_TIMEOUT=180
SIMLAB_DATA_DIR=./backend/uploads/simlab
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FLASK_DEBUG=false
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-local-password
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text
# Optional explicit alternative; never selected automatically.
OLLAMA_MODEL=qwen2.5:3b
LLM_BASE_URL=http://127.0.0.1:11434/v1
OASIS_DEFAULT_MAX_ROUNDS=1
REPORT_AGENT_MAX_TOOL_CALLS=3
# Optional server-owned interactive target registry. Unset means local fixtures/uploads only.
# SIMLAB_JOURNEY_TARGETS_FILE=/absolute/private/path/journey-targets.json

# Optional private case definition; never commit this file or its evidence.
# SIMLAB_CASE_FILE=/absolute/private/path/case.json
# Passive public-document collection is disabled until an explicit host is configured.
# SIMLAB_KNOWLEDGE_HOST=public.example.test
